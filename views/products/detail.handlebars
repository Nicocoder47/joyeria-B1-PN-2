<h1>{{product.name}}</h1>
<img src="{{#if product.images.[0]}}{{product.images.[0]}}{{else}}/assets/placeholder.png{{/if}}" width="300" />
<p>Precio: ${{product.price}}</p>
<p>Categoría: {{product.category}}</p>
<p>Metal: {{product.metal}}</p>
<p>Stock: {{product.stock}}</p>
<p>{{product.description}}</p>
<form method="post" action="/views/products/{{product._id}}/add-to-cart">
  <button type="submit">Agregar al carrito</button>
</form>
<a href="/views/products">Volver a la lista</a>
