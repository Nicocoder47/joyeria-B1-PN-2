<h1>Carrito {{cart._id}}</h1>
{{#if cart.products.length}}
  <ul>
    {{#each cart.products}}
      <li>
        <h3>{{this.product.name}} — ${{this.product.price}}</h3>
        <p>Cantidad: {{this.quantity}}</p>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>El carrito está vacío</p>
{{/if}}
<a href="/views/products">Seguir comprando</a>
